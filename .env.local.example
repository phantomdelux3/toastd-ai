# GCP project number (NOT the project ID — found via: gcloud projects describe toastd --format='value(projectNumber)')
GCP_PROJECT_NUMBER=698151665057
GCP_LOCATION=us-central1
REASONING_ENGINE_ID=8982788447336923136

# Optional: path to a service-account JSON key. Leave empty to use Application Default Credentials (ADC)
# from `gcloud auth application-default login` — recommended for local dev.
GOOGLE_APPLICATION_CREDENTIALS=
